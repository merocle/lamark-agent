# Lamark L3 knowledge-edit image (ROME/MEMIT via EasyEdit).
#
# Built on NGC PyTorch 26.01 (working torch+CUDA for GB10 sm_121 / CUDA 13 on
# aarch64). We add the EasyEdit MEMIT dependency surface on top WITHOUT
# touching torch — EasyEdit's own requirements.txt pins torch==2.9.1, which
# would downgrade the container's 2.10 build and break the Mamba kernels that
# NemotronH needs for its forward passes.
#
# Build (on the Spark host, with EasyEdit cloned at ~/EasyEdit):
#   docker build -f learning/docker/Dockerfile.edit -t lamark/edit:26.01 .
#
# Run via learning/scripts/spark/05_run_edit.sh — it expects this tag.

FROM nvcr.io/nvidia/pytorch:26.01-py3

# EasyEdit's MEMIT path imports transformers + datasets (covariance estimation
# over wikitext) + einops; accelerate is required by transformers `device_map`;
# scipy/scikit-learn back the running-statistics covariance code. transformers
# is pinned to EasyEdit's tested version. torch is intentionally NOT listed so
# the resolver keeps the pre-installed 2.10 build.
RUN pip install --no-cache-dir \
        "transformers==4.57.1" \
        "datasets>=3.0" \
        "einops>=0.8" \
        "accelerate>=0.34" \
        "scipy>=1.11" \
        "scikit-learn>=1.3" \
        "sentencepiece>=0.2" \
        "hf_transfer>=0.1.8" \
        "pyyaml>=6" \
        "httpx>=0.27" \
        "higher>=0.2.1" \
        "hydra-core>=1.3" \
        "omegaconf>=2.3" \
        "nltk>=3.6" \
        "sentence-transformers>=3.2" \
        "peft>=0.13"

# EasyEdit eagerly imports its multimodal editors (BLIP-2 / COCO / Qwen-VL)
# from `easyeditor/__init__.py`, so importing ANY submodule (even memit) drags
# in this surface. We don't use the multimodal path, but the imports must
# resolve. opencv-python-headless provides `cv2` without needing system libGL.
RUN pip install --no-cache-dir \
        "timm>=1.0" \
        "opencv-python-headless>=4.10" \
        "av>=14" \
        "fairscale>=0.4" \
        "iopath>=0.1" \
        "qwen-vl-utils>=0.0.10" \
        "openai>=1.0" \
        "zhipuai>=2.1" \
        "rouge>=1.0"

# Mamba SSM + causal-conv1d kernels: NemotronH is a hybrid Mamba model and its
# forward passes (which MEMIT runs during covariance + the v-optimization) need
# these. Built against the in-image torch, so --no-build-isolation.
RUN pip install --no-cache-dir --no-build-isolation mamba-ssm causal-conv1d

# Smoke-check the import surface that does NOT depend on the runtime /easyedit
# mount, so we fail fast at build time. The easyeditor import chain itself is
# validated separately at runtime (it needs /easyedit on sys.path).
RUN python -c "import transformers, datasets, einops, accelerate, scipy, sklearn, higher, omegaconf, hydra, nltk, sentence_transformers; \
print(f'transformers {transformers.__version__} datasets {datasets.__version__} ok')"
RUN python -c "import mamba_ssm, causal_conv1d; print('mamba-ssm + causal-conv1d ok')"

LABEL org.opencontainers.image.title="lamark-edit" \
      org.opencontainers.image.description="EasyEdit MEMIT/ROME stack on NGC PyTorch 26.01 for DGX Spark sm_121" \
      org.opencontainers.image.source="https://github.com/lamark-agent/lamark-agent"

WORKDIR /workspace

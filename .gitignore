# ── Rust / Cargo ─────────────────────────────────────────────────────────────
target/
Cargo.lock

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg
MANIFEST

# uv / venv
.venv/
venv/
ENV/
.python-version
uv.lock

# ── Model weights and artifacts — NEVER commit ───────────────────────────────
models/
*.safetensors
*.gguf
*.bin
*.pt
*.pth

# ── LoRA adapters — local only, may contain user-trained personal data ────────
python/adapters/*.bin
python/adapters/*.safetensors
python/adapters/*/checkpoint-*/
python/adapters/*.gguf

# ── Training outputs ──────────────────────────────────────────────────────────
outputs/
runs/
wandb/

# ── Lamark runtime — user personal data, never commit ────────────────────────
.lamark/
*.lamark.db
data/memory/
data/embeddings/
data/lancedb/
data/honcho/
*.db
*.db-journal
*.sqlite
*.sqlite3

# ── Curated training data — contains personal conversations ──────────────────
data/curated/
data/raw/
data/redacted/
data/replay_buffer/

# ── Secrets ───────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example
*.key
*.pem
secrets/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Generated / build artifacts ───────────────────────────────────────────────
/dist/
/webui/.svelte-kit/
/webui/build/
/webui/node_modules/

# ── Tests / coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# ── Type checking ─────────────────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/

# ── Smoke test results (Spark-specific) ──────────────────────────────────────
smoke_test_results/
*.smoke.json

# ── Hermes vendor — code committed, runtime artefacts ignored ────────────────
python/vendor/hermes/**/__pycache__/
python/vendor/hermes/**/*.pyc
python/vendor/hermes/**/node_modules/
python/vendor/hermes/**/.venv/
python/vendor/hermes/.lamark/

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.iml
*.swp
*.swo

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store

# generated training corpus (assembled train/val + teacher/HF data — may contain
# external/teacher content; regenerable; never commit per invariant 3)
learning/datasets/out/

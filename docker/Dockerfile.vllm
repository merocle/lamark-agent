# Lamark FINE-TUNE / training image (Spark-native, aarch64 / GB10 sm_121).
#
# Built on NGC PyTorch (which has working torch+CUDA for GB10 sm_121 on aarch64,
# something upstream pip wheels don't currently provide). This image carries
# the fine-tune toolchain (transformers/peft/trl/accelerate) that the nightly
# trainer needs — the dispatcher runs INSIDE this image.
#
# NOTE: serving is NOT this image. `lamark serve` runs the upstream
# `vllm/vllm-openai:v0.21.0` image (multi-arch, canonical). This image exists
# for TRAINING. The legacy `scripts/vllm_server.sh` (deprecated) also used it.
#
# Build:
#   docker build -f docker/Dockerfile.vllm -t lamark/vllm:25.10 .

FROM nvcr.io/nvidia/pytorch:25.10-py3

# vLLM + the fine-tune stack. Pinned to the EXACT versions the working
# lamark/vllm:25.10 image resolved to, so a rebuild is reproducible (the
# readiness review flagged the old unpinned ranges as a rebuild hazard —
# note transformers is 5.x here, so the old "<5" caps elsewhere were wrong).
# torch is NOT pip-installed: it comes from the NGC base image.
RUN pip install --no-cache-dir \
        "vllm==0.21.0" \
        "transformers==5.9.0" \
        "accelerate==1.13.0" \
        "peft==0.19.1" \
        "trl==1.4.0" \
        "hf_transfer>=0.1.8" \
        "sentencepiece>=0.2" \
        "huggingface_hub>=0.25"

# Smoke-check that vLLM imports inside the build so we fail fast at build
# time instead of at runtime.
RUN python -c "import vllm; print(f'vllm {vllm.__version__} ok')"

# Provide a quick `--version` for the image itself
LABEL org.opencontainers.image.title="lamark-vllm" \
      org.opencontainers.image.description="vLLM + FT stack on NGC PyTorch for DGX Spark sm_121" \
      org.opencontainers.image.source="https://github.com/merocle/lamark-agent"

WORKDIR /workspace
